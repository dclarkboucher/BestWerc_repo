library(dplyr)
library(tidyr)
library(purrr)
library(ggplot2)
library(ggh4x)
Rcpp::sourceCpp("source/survival_power.cpp")
# Settings
alpha_0 <- 0.05
n_1 <- 200
n_0 <- 100
setting_dat <-
expand_grid(
avg_surv_time = c(1,2),
shape = c(0.8,1.2),
cens_prob = c(0.4)
) %>%
mutate(
lambda = avg_surv_time / gamma(1+1/shape),
lambda_cens = ((lambda^shape) *(1-cens_prob) / (cens_prob))^(1/shape),
delta = c(0.532,.322,1.064,.645),
alpha_0 = c(0.026, 0.066, 0.026, 0.066),
setting = 1:n()
)
reps <- 5000
settings <- seq_len(nrow(setting_dat))
rs <- c(-0.5, -0.3, 0, 0.3, 0.5)
# rs <- 0
scenarios <- c(0,1)
a_0s <- seq(0, 0.9, by = 0.1)
# a_0s <- 0
out_list <- list()
j <- 1
for (set in settings){
print(set)
lambda <- setting_dat$lambda[set]
lambda_cens <- setting_dat$lambda_cens[set]
delta <- setting_dat$delta[set]
shape <- setting_dat$shape[set]
alpha_0 <- setting_dat$alpha_0[set]
mu_0 <- setting_dat$avg_surv_time[set]
for (r in rs){
for (scen in scenarios){
mu_0h <- mu_0 + delta * r
mu_1 <- mu_0 + delta * scen
lambda0 <- mu_0 / gamma(1+1/shape)
lambda1 <- mu_1 / gamma(1+1/shape)
for( rep in seq_len(reps)){
# Generate data
set.seed(rep)
lambda_x0 <- (lambda0^(-shape) + lambda_cens^(-shape)) ^ (-1/shape)
lambda_x1 <- (lambda1^(-shape) + lambda_cens^(-shape)) ^ (-1/shape)
x0_dat <- rweibull(n_0, shape = shape, scale = lambda_x0)
x0 <- sum(x0_dat)
x1_dat <- rweibull(n_1, shape = shape, scale = lambda_x1)
x1 <- sum(x1_dat)
u0 <- rbinom(1,n_0, prob = (lambda_cens^shape) / (lambda_cens^shape + lambda0^shape))
u1 <- rbinom(1,n_1, prob = (lambda_cens^shape) / (lambda_cens^shape + lambda1^shape))
for (a_0 in a_0s){
n_0h <- n_0 * (a_0) / (1-a_0);
# Determine posterior distribution for this borrowing fraction (exponential assumption)
alpha0 <- n_0h + u0
beta0 <- n_0h * mu_0h + x0
alpha1 <- u1
beta1 <- x1
prob <- gamma_diff_prob(
0, alpha0, beta0, alpha1, beta1, 1000, 1e-4
)
decision <- as.numeric(prob > 1 - alpha_0)
out_list[[j]] <-
data.frame(
setting = set,
r = r,
scenario = scen,
rep = rep,
a_0 = a_0,
decision = decision
)
j <- j + 1
}
}
}
}
}
results <-
bind_rows(out_list) %>%
group_by(setting, scenario, r, a_0) %>%
summarize(performance = mean(decision)) %>%
mutate(
scenario = ifelse(scenario == 1, "H1", "H0")
) %>%
left_join(setting_dat, by = "setting")
results %>%
pivot_wider(names_from = scenario, values_from = performance) %>%
select(avg_surv_time, shape, H0, H1)
library(dplyr)
library(tidyr)
library(purrr)
library(ggplot2)
library(ggh4x)
Rcpp::sourceCpp("source/survival_power.cpp")
# Settings
alpha_0 <- 0.05
n_1 <- 200
n_0 <- 100
setting_dat <-
expand_grid(
avg_surv_time = c(1,2),
shape = c(0.8,1.2),
cens_prob = c(0.4)
) %>%
mutate(
lambda = avg_surv_time / gamma(1+1/shape),
lambda_cens = ((lambda^shape) *(1-cens_prob) / (cens_prob))^(1/shape),
delta = c(0.532,.322,1.064,.645),
alpha_0 = c(0.026, 0.066, 0.026, 0.066),
setting = 1:n()
)
reps <- 2
settings <- seq_len(nrow(setting_dat))
rs <- c(-0.5, -0.3, 0, 0.3, 0.5)
# rs <- 0
scenarios <- c(0,1)
a_0s <- seq(0, 0.9, by = 0.1)
# a_0s <- 0
out_list <- list()
j <- 1
for (set in settings){
print(set)
lambda <- setting_dat$lambda[set]
lambda_cens <- setting_dat$lambda_cens[set]
delta <- setting_dat$delta[set]
shape <- setting_dat$shape[set]
alpha_0 <- setting_dat$alpha_0[set]
mu_0 <- setting_dat$avg_surv_time[set]
for (r in rs){
for (scen in scenarios){
mu_0h <- mu_0 + delta * r
mu_1 <- mu_0 + delta * scen
lambda0 <- mu_0 / gamma(1+1/shape)
lambda1 <- mu_1 / gamma(1+1/shape)
for( rep in seq_len(reps)){
# Generate data
set.seed(rep)
lambda_x0 <- (lambda0^(-shape) + lambda_cens^(-shape)) ^ (-1/shape)
lambda_x1 <- (lambda1^(-shape) + lambda_cens^(-shape)) ^ (-1/shape)
x0_dat <- rweibull(n_0, shape = shape, scale = lambda_x0)
x0 <- sum(x0_dat)
x1_dat <- rweibull(n_1, shape = shape, scale = lambda_x1)
x1 <- sum(x1_dat)
u0 <- rbinom(1,n_0, prob = (lambda_cens^shape) / (lambda_cens^shape + lambda0^shape))
u1 <- rbinom(1,n_1, prob = (lambda_cens^shape) / (lambda_cens^shape + lambda1^shape))
for (a_0 in a_0s){
n_0h <- n_0 * (a_0) / (1-a_0);
# Determine posterior distribution for this borrowing fraction (exponential assumption)
alpha0 <- n_0h + u0
beta0 <- n_0h * mu_0h + x0
alpha1 <- u1
beta1 <- x1
prob <- gamma_diff_prob(
0, alpha0, beta0, alpha1, beta1, 1000, 1e-4
)
estimate <- beta0 / alpha0
decision <- as.numeric(prob > 1 - alpha_0)
out_list[[j]] <-
data.frame(
setting = set,
r = r,
scenario = scen,
rep = rep,
a_0 = a_0,
decision = decision,
estimate = estimate
)
j <- j + 1
}
}
}
}
}
bind_rows(out_list)
results <-
bind_rows(out_list) %>%
group_by(setting, scenario, r, a_0) %>%
summarize(
performance = mean(decision),
mean = mean(estimate)
) %>%
mutate(
scenario = ifelse(scenario == 1, "H1", "H0")
) %>%
left_join(setting_dat, by = "setting")
results
