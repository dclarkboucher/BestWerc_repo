out <- c(decision, ess, mean)
names(out) <- c("decision", "ess", "mean")
out
}
# Settings ----------------------------------------------------------------
k <- 2
lambda <- 1
sigma <- 1/sqrt(lambda)
n_1 <- 40
n_0 <- n_1 / k
prob0 <- 0.95
power_want <- 0.65
Delta <- 0
mu_0 <- 0
delta <- (qnorm(prob0) + qnorm(power_want)) * sqrt(k+1) / sqrt(n_1 * lambda)
alpha_0 <- 0.05
# Prior derivation --------------------------------------------------------
sigma <- 1
study_data <-
data.frame(
study = c("A","B", "C"),
n = c(120, 150, 170),
sd = sigma,
estimate  = c(0.18, 0.22,0.20)
)
study_data$se <- with(study_data, sd / sqrt(n))
.user_mc_options <-
options(
RBesT.MC.warmup = 50 * 200,
RBesT.MC.iter = 100 * 200,
RBesT.MC.chains = 2,
RBesT.MC.thin = 5,
RBesT.MC.control=list(adapt_delta=0.999))
set.seed(1)
map_mcmc <- gMAP(cbind(estimate, se) ~ 1 | study,
data = study_data,
weights = n,
beta.prior = cbind(0, sigma),
tau.dist = "HalfNormal",
tau.prior = sigma/5,
family = gaussian)
map <- automixfit(map_mcmc)
map_sum <- summary(map)
max(map_sum[5] - map_sum[1], map_sum[1] - map_sum[3]) / delta
summary(map)
y_0h <- summary(map)['mean']; y_0h
weak_prior <-
mixnorm(c(1,y_0h,1),
sigma = sigma,
param = "mn"
)
######## ELASTIC PRIOR
# Informative prior
n_h <- sum(study_data$n)
ep_initial_prior <-
RBesT::mixnorm(
comp1 = c(1, y_0h, n_h),
sigma = sigma,
param = "mn"
)
ep_csd <- abs(delta) # clinically significant difference.
q0 <- 0.025
q1 <- 0.275
R <- 5000
set.seed(1)
hparams <-
get_a_b(
y_0h = y_0h,
n_h = n_h,
csd = ep_csd,
R = R,
n_0 = n_0,
c1 = 0.99,
c2 = 0.01,
q0 = q0,
q1 = q1,
sigma = sigma)
a_ep <- hparams$a
b_ep <- hparams$b
# Simulations -------------------------------------------------------------
nreps <- 1000
methods <- c("SAM","MAP","EP")
rs <- c(-0.5,-0.3, -0.1, 0, 0.1, 0.3, 0.5)
sam_csd <- abs(delta)
thresholds <- c(0.972, 0.975,.95)
names(thresholds) <- c("SAM","MAP","EP")
thresholds <- thresholds[methods]
map_wt <- 0.20
out_list <- list()
j <- 1
for (r in rs){
mu_0 <- y_0h - r * delta
for (method in methods){
power <- 0
t1e <- 0
biases <- numeric(nreps)
esses <- numeric(nreps)
for (rep in seq_len(nreps)){
set.seed(rep)
y0_dat <- rnorm(n_0, mean = mu_0, sd = sigma)
y1_dat <- rnorm(n_1, mean = mu_0, sd = sigma)
# Performance under null
out <-
analyze(
y0_dat = y0_dat,
y1_dat = y1_dat,
prior0 = map,
prior1 = weak_prior,
ep_prior = ep_initial_prior,
method = method,
sigma = sigma,
wt = map_wt,
csd = sam_csd,
a_ep = a_ep,
b_ep = b_ep
)
d0 <- out["decision"]
ess <- out["ess"]
mu_0_hat <- out["mean"]
out_list[[j]] <-
data.frame(
method = method,
r = r,
rep = rep,
scenario = 0,
ess = ess - n_0,
est = mu_0_hat,
d = d0,
mn = mean(y0_dat)
)
j <- j + 1
# Performance under alternative
out <-
analyze(
y0_dat = y0_dat,
y1_dat = y1_dat + delta,
prior0 = map,
prior1 = weak_prior,
ep_prior = ep_initial_prior,
method = method,
sigma = sigma,
wt = map_wt,
csd = sam_csd,
a_ep = a_ep,
b_ep = b_ep
)
d1 <- out["decision"]
out_list[[j]] <-
data.frame(
method = method,
r = r,
rep = rep,
scenario = 1,
ess = ess - n_0,
est = mu_0_hat,
d = d1,
mn = mean(y1_dat)
)
j <- j + 1
}
}
}
results <-
bind_rows(out_list) %>%
tibble()
saveRDS(results,"results/sims_normal_esscomp.rds")
results1 <-
results %>%
mutate(
mu_0 = y_0h - r * delta,
bias = est - mu_0
)
results1 %>%
filter(scenario==1) %>%
group_by(r) %>%
summarize(
bias = mean(bias),
bias_sd = sd(est)
)
results1 %>%
ggplot(aes(x = bias)) +
facet_wrap(~factor(r)) +
geom_histogram(binwidth = 0.05)
library(ggplot2)
results1 <-
results %>%
mutate(
mu_0 = y_0h - r * delta,
bias = est - mu_0
)
results1 %>%
filter(scenario==1) %>%
group_by(r) %>%
summarize(
bias = mean(bias),
bias_sd = sd(est)
)
results1 %>%
ggplot(aes(x = bias)) +
facet_wrap(~factor(r)) +
geom_histogram(binwidth = 0.05)
results1 %>%
ggplot(aes(x = ess)) +
facet_wrap(~factor(r)) +
geom_histogram()
results1 %>%
filter(scenario == 0, method == "EP") %>%
ggplot(aes(y = ess, x = mn)) +
facet_wrap(~factor(r)) +
geom_point(color = "dodgerblue4", alpha=0.2) +
labs(x = "Raw sample mean of controls", y = "ESS") +
theme_bw()
results1 %>%
filter(scenario == 0,r %in% c(-0.5, 0, 0.5)) %>%
mutate(r = paste0("r = ",r)) %>%
ggplot(aes(y = ess, x = mn, color = method)) +
facet_wrap(~factor(r)) +
geom_vline(aes(xintercept = y_0h), color = "black") +
geom_point(alpha=0.3) +
scale_color_manual(values = c("dodgerblue4", "firebrick4", "darkorange4")) +
labs(x = "Raw sample mean of controls", y = "ESS") +
theme_bw()
results1 %>%
filter(scenario == 0,r %in% c(-0.5, 0, 0.5)) %>%
mutate(r = paste0("r = ",r)) %>%
ggplot(aes(y = ess, x = mn, color = method)) +
facet_wrap(~factor(r)) +
geom_vline(aes(xintercept = y_0h), color = "black") +
geom_point(alpha=0.3) +
scale_color_manual(values = c("dodgerblue4", "firebrick4", "darkorange4")) +
